#!/usr/bin/env python3
"""Purepy CLI tool."""

import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from pure.compile.Internal.CheckCommand import CheckCommand
from pure.compile.Internal.ArtifactCommand import ArtifactCommand
from pure.component.Registry import Registry


def main():
    argv = sys.argv[1:]

    if argv and argv[0] in ('-v', '--version', 'version'):
        from pure import __version__
        print(f"pure {__version__}")
        return 0

    if argv and argv[0] == 'check':
        return CheckCommand(lambda f: Registry.unitsFor(f)).run(argv)

    # Everything else -- compile, help, a bare `pure`, an unknown command -- is
    # answered by the artifact command, which owns the usage text and the exit
    # codes.
    return ArtifactCommand(lambda f: Registry.unitsFor(f)).run(argv)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except SystemExit:
        raise
    except BaseException as error:
        # A unit that explodes while loading is a one-line report, not a
        # traceback: the stack names library internals the caller cannot act on.
        print(f"pure: {error}", file=sys.stderr)
        sys.exit(1)
